{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreativeStudio",
  "mainBinaryName": "CreativeStudio",
  "version": "0.1.4",
  "identifier": "com.bluxtech.studio",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMUFBMjFCQkUxQzUzNjkKUldScFV4eStHNklhOGtXcWZwcnpmYzZFcWxuaWxvQXdIc0tIYjE3VDIzZDI0Vnh2SzY2N3VxU3IK",
      "endpoints": ["https://github.com/mathew-endreson/CreativeStudio/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "BluxTech",
    "category": "Video",
    "shortDescription": "Video ad studio",
    "longDescription": "CreativeStudio turns talking-head footage into finished Darija video ads on your own PC: captions, hook / body / CTA transitions, pictures in front of the speaker, -15 LUFS renders.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerHooks": "./installer/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "French", "Arabic"],
        "displayLanguageSelector": true
      }
    }
  }
}
