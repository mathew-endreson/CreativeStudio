{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. Its page is served by the local engine on 127.0.0.1, so that origin gets the Tauri API (file pickers, the window's own controls) and the app's own update commands.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "process:default",
    "updater:default",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install"
  ]
}
